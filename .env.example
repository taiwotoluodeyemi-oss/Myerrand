# My Errand production environment template.
# Copy to .env only for local/server deployment; NEVER commit .env.
NODE_ENV=production
PORT=5000

# Primary database (MySQL/MariaDB). Remote production MySQL requires verified TLS.
USE_MONGO=false
MYSQL_HOST=db.example.internal
MYSQL_PORT=3306
MYSQL_USER=errand_app
MYSQL_PASSWORD=REPLACE_WITH_SECRET
MYSQL_DATABASE=errandsplace
MYSQL_CA_PATH=/run/secrets/mysql-ca.pem
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=15000

# Authentication — generate a long random value; do not use this placeholder.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRY=7d
JWT_ISSUER=my-errand
JWT_AUDIENCE=my-errand-client

# Browser/API origins. Keep Codespaces and demo login disabled in production.
CLIENT_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
ALLOW_CODESPACES=false
ALLOW_DEMO_LOGIN=false
ALLOW_INSECURE_EMAIL_VERIFY=false

# Payments. Required for live Paystack deposits.
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=REPLACE_WITH_PAYSTACK_SECRET_KEY
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PAYOUTS_ENABLED=false

# Webhook / MFA encryption secrets.
WEBHOOK_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET

# Optional operational integrations.
SUPPORT_EMAIL=support@example.com
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMS_WEBHOOK_URL=

# Maps: public client key and server-only key are distinct.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Logging / locale / market defaults.
LOG_LEVEL=info
DEFAULT_CURRENCY=NGN
AUTO_DETECT_LOCALE=true
PRIMARY_MARKET_CITY=Ibadan
PRIMARY_MARKET_COUNTRY=Nigeria
PRIMARY_MARKET_COUNTRY_ISO2=NG
PRIMARY_MARKET_DISPLAY_NAME=Ibadan
PRIMARY_MARKET_CURRENCY=NGN
PRIMARY_MARKET_ID=
PRIMARY_MARKET_STATUS=active
PRIMARY_MARKET_VERIFICATION_MODE=manual
PRIMARY_MARKET_REQUIRE_VERIFIED_RUNNERS=true
PRIMARY_MARKET_INSURANCE_MODE=acknowledgement_only
PRIMARY_MARKET_ZONES=
