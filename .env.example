# Server
PORT=5000
NODE_ENV=development

# Frontend (local / Codespaces)
CLIENT_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
# Optional WordPress origin allowed to call the API
WORDPRESS_URL=

# Allow CORS from *.github.dev (Codespaces) automatically
ALLOW_CODESPACES=true

# Database — use MySQL as primary (wallet + errands require it)
USE_MONGO=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=errand_user
MYSQL_PASSWORD=errand_dev_password
MYSQL_DATABASE=errandsplace
MYSQL_ROOT_PASSWORD=root_dev_password
# Optional MySQL pool tuning
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=10000

# MongoDB only if you set USE_MONGO=true (auth only; not used by wallet/errands)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Auth — setup-env.js generates a strong secret if left as placeholder
JWT_SECRET=your-super-secure-jwt-secret-here-make-it-long-and-random
JWT_EXPIRY=7d

# Payments (optional — leave blank to use simulated / disabled flows)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PAYOUTS_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Live errand tracking map (optional — cards fall back to a plain address
# list if either key is missing). These are deliberately TWO different keys:
#
# GOOGLE_MAPS_API_KEY — read at CLIENT BUILD TIME (npm run build / npm run
#   client), baked into the browser bundle. This key is meant to be public;
#   in Google Cloud Console, restrict it by HTTP referrer to your domain(s)
#   (e.g. https://yourapp.com/*, http://localhost:3001/* for dev), and
#   restrict its APIs to "Maps JavaScript API" only.
#
# GOOGLE_MAPS_SERVER_KEY — read at SERVER RUNTIME, used only for geocoding
#   plain-text addresses into lat/lng (never sent to the browser). Restrict
#   it by IP address to your server(s), and to "Geocoding API" only. Google
#   won't let one key carry both a referrer restriction and an IP
#   restriction, which is why this can't just reuse the browser key above.
#
# Get both from https://console.cloud.google.com/google/maps-apis — create
# a project, enable "Maps JavaScript API" and "Geocoding API", then create
# two API keys under "Credentials" with the restrictions described above.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Email (optional)
EMAIL_FROM=noreply@yourdomain.com

# Demo login (disable in production)
ALLOW_DEMO_LOGIN=true
SEED_ADMIN=false


# Email verification (optional — without SMTP, tokens returned in non-production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
RETURN_VERIFY_TOKEN=true
RETURN_RESET_TOKEN=true
ALLOW_INSECURE_EMAIL_VERIFY=false

# Maps (optional — app works without; tracking shows fallback)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# ---- Errand pricing engine (utils/pricing.js) ----
# Fuel price in NGN per litre (update as pump prices change)
FUEL_PRICE_NGN_PER_LITRE=950
# Flat base fare (same currency unit as rates)
BASE_FARE=200
# Per-mode rate per km
RATE_PER_KM_FOOT=80
RATE_PER_KM_BICYCLE=120
RATE_PER_KM_MOTORCYCLE=200
RATE_PER_KM_CAR=350
# Fuel consumption L/km (foot/bicycle are 0 in code)
FUEL_L_PER_KM_MOTORCYCLE=0.04
FUEL_L_PER_KM_CAR=0.12
# Platform fee as fraction of subtotal (0.15 = 15%)
PLATFORM_FEE_PERCENT=0.15
# Nigeria VAT 7.5% — applied on (subtotal + platform_fee)
VAT_PERCENT=0.075
# Urgency multipliers
URGENCY_MULT_LOW=1.0
URGENCY_MULT_NORMAL=1.0
URGENCY_MULT_MEDIUM=1.0
URGENCY_MULT_HIGH=1.15
URGENCY_MULT_URGENT=1.3
# Haversine road factor when Distance Matrix is unavailable
ROAD_FACTOR=1.3
