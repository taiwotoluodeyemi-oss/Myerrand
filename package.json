{
  "name": "my-errand-app",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "build:cordova": "cd client && CORDOVA=true npm run build && cd .. && node scripts/prepare-cordova.js",
    "cordova:prepare": "cordova prepare",
    "cordova:build:android": "npm run build:cordova && npx cordova prepare android && npx cordova build android",
    "cordova:run:android": "npm run build:cordova && npx cordova run android",
    "build:prod": "cd client && npm run build && cd .. && npm run start",
    "install-client": "cd client && npm install",
    "setup-db": "node scripts/setup-database.js",
    "setup-gift-cards": "node scripts/setup-gift-card-system.js",
    "db:start": "docker compose -f docker-compose.yml up -d mariadb",
    "db:stop": "docker compose -f docker-compose.yml down",
    "db:logs": "docker compose -f docker-compose.yml logs -f mariadb",
    "test": "node --test tests/smoke.test.js tests/money-path.test.js tests/money-engine.test.js tests/pricing.test.js tests/zone-ops.test.js tests/city-scale.test.js tests/stage4.test.js tests/stage5.test.js tests/security-hardening.test.js",
    "setup": "node scripts/setup-env.js && npm install && npm run install-client",
    "bootstrap": "node scripts/bootstrap.js",
    "setup:env": "node scripts/setup-env.js",
    "postinstall": "node scripts/setup-env.js || true",
    "start:all": "npm run db:start && npm run dev",
    "seed": "node scripts/seed-demo.js",
    "db:align": "node scripts/align-schema.js",
    "cordova:android": "npm run build:cordova && cordova prepare android && cordova build android",
    "cordova:android:release": "npm run build:cordova && cordova prepare android && cordova build android --release",
    "cordova:run": "npm run build:cordova && cordova run android",
    "apk": "npm run cordova:build:android",
    "international": "node scripts/auto-international.js",
    "align-db": "node scripts/apply-qa-alignment.js",
    "fixed-max-budget-column": "node scripts/fixed-max-budget-column.js",
    "db:zone": "node scripts/apply-zone-ops.js",
    "db:city": "node scripts/apply-city-scale.js",
    "db:stage5": "node scripts/apply-stage5.js",
    "db:stage6": "node scripts/apply-stage6.js",
    "test:stage6": "node --test tests/stage6.test.js tests/stage5.test.js tests/money-engine.test.js",
    "db:stage7": "node scripts/apply-stage7.js",
    "test:stage7": "node --test tests/stage7.test.js tests/stage6.test.js tests/stage5.test.js",
    "db:stage8": "node scripts/apply-stage8.js",
    "test:stage8": "node --test tests/stage8.test.js tests/stage7.test.js tests/stage6.test.js tests/stage5.test.js",
    "test-security": "node --test tests/security-hardening.test.js",
    "test:money-integrity": "node --test tests/money-integrity.test.js",
    "test:auth-security": "node --test tests/auth-security.test.js",
    "db:auth-security": "node scripts/apply-auth-security.js",
    "db:money-integrity": "node scripts/apply-money-integrity.js",
    "test:admin-mfa": "node --test tests/admin-mfa.test.js",
    "test:admin-mfa-rate-limit": "node --test tests/admin-mfa-rate-limit.test.js tests/admin-mfa.test.js",
    "test:enterprise-security": "node --test tests/enterprise-api-security.test.js tests/webhook-operations.test.js tests/stage8.test.js tests/stage5.test.js tests/security-hardening.test.js",
    "db:enterprise-api-security": "node scripts/apply-enterprise-api-security.js",
    "db:webhook-operations": "node scripts/apply-webhook-operations.js",
    "test:webhook-operations": "node --test tests/webhook-operations.test.js",
    "db:privacy-controls": "node scripts/apply-privacy-controls.js",
    "test:privacy": "node --test tests/privacy-controls.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@paypal/react-paypal-js": "^8.8.3",
    "@react-google-maps/api": "^2.20.7",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "build": "^0.1.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.2",
    "nodemailer": "^10.0.10",
    "react-i18next": "^15.6.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-plugin-dialogs": "^2.0.2",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "cordova-plugin-network-information": "^3.0.0",
    "cordova-plugin-statusbar": "^4.0.0",
    "nodemon": "^3.0.1"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-dialogs": {},
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-statusbar": {}
    },
    "platforms": [
      "android"
    ]
  }
}
